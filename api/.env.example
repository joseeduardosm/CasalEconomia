# Variáveis de ambiente do CasalEconomia API
# Copie este arquivo para .env e preencha com os valores reais

# String de conexão com o banco de dados PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casaleconomia_dev

# Chave secreta para assinar tokens JWT (use uma string longa e aleatória em produção)
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:4200
